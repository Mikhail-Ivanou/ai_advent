PORT=3002

# Bearer token every client must send as `Authorization: Bearer <token>`.
# Leave empty only for local development; ALWAYS set it on a public server.
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Forecast endpoint. Leave empty for the default (https://api.open-meteo.com/v1/forecast).
# On networks where that address is unreachable (h3llo.cloud VMs, for one),
# Open-Meteo's other host serves identical data at the same path:
# OPEN_METEO_FORECAST_URL=https://previous-runs-api.open-meteo.com/v1/forecast
OPEN_METEO_FORECAST_URL=

# Public address of this server, used in save_to_file download links,
# e.g. http://176.53.174.74:3002 (the server can't know it behind NAT/proxies).
PUBLIC_BASE_URL=

# docker compose only ------------------------------------------------------
# Interface the plain-HTTP port binds to on the host. Set to 127.0.0.1 when
# running with `--profile tls`, so traffic can only arrive through Caddy.
WEATHER_BIND=0.0.0.0
# Domain pointing at this VM — required for `--profile tls` (Let's Encrypt).
DOMAIN=
