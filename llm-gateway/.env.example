# Address the gateway listens on. 0.0.0.0 = reachable from the network;
# Ollama itself stays on 127.0.0.1 and is only reached through here.
PORT=8088
HOST=0.0.0.0
OLLAMA_URL=http://127.0.0.1:11434

# API keys, comma-separated "client:key" pairs. Clients send
# `Authorization: Bearer <key>`; the client name shows up in logs and is
# what the rate limit counts against. Generate a key: openssl rand -hex 24
GATEWAY_KEYS=
# ALLOW_NO_AUTH=1   # only for experiments with HOST=127.0.0.1

DEFAULT_MODEL=qwen2.5:7b
# Models clients may use; empty = everything installed in Ollama.
ALLOWED_MODELS=qwen2.5:7b,gemma3:12b

# Limits ---------------------------------------------------------------------
# Context window the model is loaded with (Ollama num_ctx). A longer
# conversation is rejected with 400 context_length_exceeded and its exact size.
MAX_CONTEXT_TOKENS=8192
# Cap on max_tokens per answer (and the default when a client sends none).
MAX_OUTPUT_TOKENS=1024
MAX_MESSAGES=100
MAX_BODY_BYTES=524288
# Requests per minute per client; 0 = off. Over the limit: 429 + Retry-After.
RATE_LIMIT_PER_MINUTE=20
# Generations at once (at most OLLAMA_NUM_PARALLEL); the rest
# wait in a queue of MAX_QUEUE, then get 503 server_busy.
MAX_CONCURRENT=1
MAX_QUEUE=8
QUEUE_TIMEOUT_MS=120000
REQUEST_TIMEOUT_MS=300000
# How long Ollama keeps the model in memory after the last request.
OLLAMA_KEEP_ALIVE=30m
