PORT=3001

# ── LLM API access ──────────────────────────────────────────────────────────
# LLM_API_URL is the provider's base URL; "/chat/completions" is appended automatically
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Local LLM (Day 26): models named "ollama/<name>" (e.g. ollama/qwen2.5:7b) go here instead —
# Ollama's OpenAI-compatible endpoint, no key needed. Install: brew install ollama && ollama pull qwen2.5:7b
LOCAL_LLM_API_URL=http://localhost:11434/v1

# LLM_MAX_TOOL_ROUNDS  — max model↔tool round trips per answer before forcing a text finish (default: 12)
# BACKGROUND_POLL_MS   — how often the background agent polls for events, in ms (default: 20000)

# ── MCP (Model Context Protocol) ──────────────────────────────────────────────
# Shared auth token for all MCP servers that have no server-specific token set.
# MCP_AUTH_TOKEN=
# Per‑tool call timeout in ms (default: 60000)
# MCP_TOOL_TIMEOUT_MS=60000

# ── RAG (Retrieval-Augmented Generation) ──────────────────────────────────
# RAG_EMBEDDING_MODEL   — local embedding model from Hugging Face (default: Xenova/multilingual-e5-small)
# RAG_DATA_DIR          — directory for the index, documents and model cache (default: <backend>/data/rag)
# RAG_RERANK_MODEL      — cross‑encoder reranker model (default: cross-encoder/mmarco-mMiniLMv2-L12-H384-v1)
# RAG_RERANK_MODEL_FILE — quantized ONNX file name for the reranker (default: model_qint8_arm64)

# ── Developer assistant (Day 31) ───────────────────────────────────────────
# The git MCP server (npm run dev:mcp-weather) and the model for /help.
# DEV_ASSISTANT_MCP_URL=http://localhost:3002/mcp/git
# DEV_ASSISTANT_MCP_TOKEN=           # defaults to MCP_AUTH_TOKEN
# DEV_ASSISTANT_MODEL=               # defaults to LLM_MODEL; e.g. ollama/qwen2.5:7b
# DEV_ASSISTANT_REPO_DIR             # repo root for docs indexing (default: parent of backend/)

# ── Code review (Day 32) ───────────────────────────────────────────────────
# REVIEW_MODEL           — model override for code reviews (default: LLM_MODEL)
# REVIEW_EXCLUDE_CONTEXT — comma‑separated paths to exclude from review context (default: empty)

# ── File agent ──────────────────────────────────────────────────────────────
# FILE_AGENT_MAX_ROUNDS  — max conversation rounds for the file‑editing agent (default: 30)

# ── Support assistant (Day 33) ─────────────────────────────────────────────
# The CRM MCP server (npm run dev:mcp-weather).
# SUPPORT_CRM_MCP_URL=http://localhost:3002/mcp/crm
# SUPPORT_CRM_MCP_TOKEN=             # defaults to MCP_AUTH_TOKEN
